{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-p", "no:cacheprovider"],
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "files.exclude": {
    ".venv": true,
    "**/__pycache__": true,
    ".pytest_cache": true,
    "**/.ipynb_checkpoints": true,
    "**/.DS_Store": true
  }
}
